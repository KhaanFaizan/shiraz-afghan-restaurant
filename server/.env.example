# ── Shiraz Server Environment Variables ──
# Copy this file to .env and fill in your values

# Port the Express server listens on
PORT=5000

# Frontend origin allowed by CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (added later)
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/shiraz?retryWrites=true&w=majority

# JWT secret for auth tokens (added later)
# JWT_SECRET=replace_with_a_long_random_string

# Node environment
NODE_ENV=development
